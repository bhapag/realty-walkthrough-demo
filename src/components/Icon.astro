---
// Small line icons. Directional ones (arrows) get .flip so they mirror in RTL;
// the rest never mirror.
interface Props { name: 'rooms' | 'bed' | 'area' | 'arrow' | 'prev' | 'next' | 'close' | 'info' | 'filter' | 'chat'; }
const { name } = Astro.props;
const paths: Record<Props['name'], string> = {
  rooms: 'M4 20V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v15M4 20h16M12 4v9m0 0H4m8 0h8',
  bed: 'M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7M3 15h18M3 18v2m18-2v2M6 9V6h5v3m2 0V6h5v3',
  area: 'M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5',
  arrow: 'M19 12H5m6-6-6 6 6 6',
  prev: 'M15 6l-6 6 6 6',
  next: 'M9 6l6 6-6 6',
  close: 'M6 6l12 12M18 6 6 18',
  info: 'M12 8h.01M11 12h1v5h1M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
  filter: 'M4 7h16M7 12h10M10 17h4',
  chat: 'M4.5 20l1.2-3.8A8 8 0 1 1 8.3 19L4.5 20Z',
};
const flip = name === 'arrow' || name === 'prev' || name === 'next';
---
<svg class:list={["icon", { flip }]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
